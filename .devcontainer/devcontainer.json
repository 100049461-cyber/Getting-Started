{
  "name": "Getting Started",
  "build": { "dockerfile": "Dockerfile" },
  "remoteUser": "codespace",
  "remoteEnv": {
    "PATH": "${containerEnv:PATH}:/home/codespace/.local/bin"
  },
  "postCreateCommand": "make install",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-vscode.cpptools",
        "vscjava.vscode-java-pack"
      ]
    }
  }
}
